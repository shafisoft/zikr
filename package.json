{
  "name": "zikr",
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "size-check": "bundlesize",
    "lint": "node scripts/check-layers.mjs && node scripts/check-migrations.mjs && eslint src --ext ts,tsx",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "predev": "node scripts/check-node.js",
    "prebuild": "node scripts/check-node.js",
    "pretest": "node scripts/check-node.js",
    "lint:layers": "node scripts/check-layers.mjs",
    "check:migrations": "node scripts/check-migrations.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "dexie": "^3.2.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.22.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/ui": "^4.1.9",
    "autoprefixer": "^10.4.0",
    "bundlesize": "^0.18.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.10.4",
    "postcss": "^8.4.0",
    "prettier": "^3.2.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-pwa": "^0.20.0",
    "vitest": "^4.1.9"
  },
  "bundlesize": [
    {
      "path": "./dist/assets/*.js",
      "maxSize": "200 kB",
      "compression": "gzip"
    }
  ],
  "engines": {
    "node": ">=20.12.0"
  }
}
